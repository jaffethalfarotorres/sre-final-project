{
  "title": "SLO and Error Budget",
  "uid": "slo-error-budget",
  "description": "SLIs, SLOs, error budget and burn rate (SRE Academy topic 0), plus synthetic checks (topic 2). Definitions are in docs/SLO.md.",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "time": {"from": "now-6h", "to": "now"},
  "refresh": "30s",
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Availability SLI (30 days)",
      "description": "Share of requests that did not fail. Objective: 90%.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.9}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sli:availability:ratio_rate30d"}]
    },
    {
      "id": 2, "type": "gauge", "title": "Availability error budget left",
      "description": "1 = budget untouched, 0 = budget spent. Below 0 the SLO is breached and the error budget policy applies.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.25}, {"color": "green", "value": 0.5}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "slo:availability:error_budget_remaining"}]
    },
    {
      "id": 3, "type": "stat", "title": "Latency SLI (30 days, /store < 500 ms)",
      "description": "Share of /store requests faster than 500 ms. Objective: 95%.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.95}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "sli:latency:ratio_rate30d"}]
    },
    {
      "id": 4, "type": "gauge", "title": "Latency error budget left",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.25}, {"color": "green", "value": 0.5}]}}, "overrides": []},
      "gridPos": {"h": 6, "w": 6, "x": 18, "y": 0},
      "targets": [{"refId": "A", "expr": "slo:latency:error_budget_remaining"}]
    },
    {
      "id": 5, "type": "timeseries", "title": "Error budget burn rate",
      "description": "1x spends the budget exactly over 30 days. The fast-burn alert fires above 6x (5 m) and 1x (1 h).",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "custom": {"thresholdsStyle": {"mode": "line"}}, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 6}]}}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [
        {"refId": "A", "expr": "slo:availability:burn_rate5m", "legendFormat": "5m"},
        {"refId": "B", "expr": "slo:availability:burn_rate1h", "legendFormat": "1h"},
        {"refId": "C", "expr": "slo:availability:burn_rate6h", "legendFormat": "6h"}
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "Availability SLI (5 m) vs objective",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [
        {"refId": "A", "expr": "sli:availability:ratio_rate5m", "legendFormat": "SLI (5m)"},
        {"refId": "B", "expr": "slo:availability:target", "legendFormat": "objective"}
      ]
    },
    {
      "id": 7, "type": "timeseries", "title": "Synthetic checks: success (blackbox exporter)",
      "description": "1 = the probe got a 2xx answer. /store fails about 5% of the time by design.",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [{"refId": "A", "expr": "avg_over_time(probe_success{job=\"blackbox-http\"}[1m])", "legendFormat": "{{instance}}"}]
    },
    {
      "id": 8, "type": "timeseries", "title": "Synthetic checks: response time",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [{"refId": "A", "expr": "probe_duration_seconds{job=\"blackbox-http\"}", "legendFormat": "{{instance}}"}]
    }
  ]
}
