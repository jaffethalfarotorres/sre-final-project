{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "sre-metrics-app values",
  "type": "object",
  "definitions": {
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "resourceList": {
      "type": "object",
      "properties": {
        "cpu": { "type": ["string", "number"] },
        "memory": { "type": ["string", "number"] }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceList" },
        "limits": { "$ref": "#/definitions/resourceList" }
      }
    },
    "monitor": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "scrapeTimeout": { "type": "string" },
        "path": { "type": "string" },
        "port": { "type": "string" },
        "labels": { "type": "object" }
      }
    }
  },
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 0 },
    "image": { "$ref": "#/definitions/image" },
    "imagePullSecrets": { "type": "array" },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "service": {
      "type": "object",
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "targetPort": { "type": ["integer", "string"] }
      }
    },
    "resources": { "$ref": "#/definitions/resources" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "env": { "type": "array" },
    "configMap": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "data": { "type": "object" }
      }
    },
    "trafficGenerator": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "replicaCount": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "targetUrl": { "type": "string" },
        "intervalSeconds": { "type": "number", "minimum": 0 },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "serviceMonitor": { "$ref": "#/definitions/monitor" },
    "podMonitor": { "$ref": "#/definitions/monitor" }
  }
}
